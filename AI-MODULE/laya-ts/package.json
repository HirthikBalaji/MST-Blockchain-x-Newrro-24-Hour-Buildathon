{
  "name": "laya-ts",
  "version": "0.1.0",
  "description": "Fast, local, on-device decision engine (TypeScript runtime)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" } },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest",
    "test:package": "node --test tests/package-e2e.mjs",
    "prepack": "npm run build"
  },
  "files": ["dist", "scripts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HirthikBalaji/MST-Blockchain-x-Newrro-24-Hour-Buildathon.git",
    "directory": "AI-MODULE/laya-ts"
  },
  "keywords": [
    "decision-model",
    "system-one",
    "routing",
    "guardrails",
    "robotics",
    "mst-blockchain",
    "onnx"
  ],
  "author": "Hirthik Balaji & Anandhappriya",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/HirthikBalaji/MST-Blockchain-x-Newrro-24-Hour-Buildathon/issues"
  },
  "homepage": "https://nandhakishorm.github.io/laya/",
  "devDependencies": { "typescript": "^5.6.0", "vitest": "^2.1.0" },
  "optionalDependencies": { "onnxruntime-node": "^1.20.0", "onnxruntime-web": "^1.20.0" }
}
